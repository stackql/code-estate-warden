# Copy to .env and fill in. .env is git ignored.
# One token per role. Never reuse a token across roles.
# Permissions listed are the minimum for a fine-grained personal access token.
# A fine-grained token only reaches one org, so auditing several orgs takes a token per org.

# Reads for snapshot. Read only.
#   Repository: Metadata read, Administration read, Contents read
#   Organization: Administration read
REPO_WARDEN_READ_TOKEN=

# Writes for apply. Only needed when running `repo-warden apply --apply`.
#   Repository: Metadata read, Administration write, Issues write
#   Organization: Administration write (only to attach org security configurations)
REPO_WARDEN_WRITE_TOKEN=

# Copilot SDK, used by plan. Fine-grained token only, classic tokens are not accepted.
#   Account: Copilot Requests
# Optional if the signed-in `gh` user has a Copilot subscription.
COPILOT_GITHUB_TOKEN=
