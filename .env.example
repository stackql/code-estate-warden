# Copy to .env and fill in. .env is git ignored.
# One token per role. Never reuse a token across roles.
#
# The read and write tokens are classic personal access tokens: a fine-grained token only
# reaches one org, a classic token reaches every org its owner belongs to. The owner must be
# an owner (or security manager) of each org, or security_and_analysis comes back null and
# those checks report unknown.

# Reads for snapshot. Scopes: repo, read:org
REPO_WARDEN_READ_TOKEN=

# Writes for apply. Only needed for `repo-warden apply --apply`.
# Scopes: repo, write:org (write:org is only used to attach org security configurations)
REPO_WARDEN_WRITE_TOKEN=

# Copilot SDK, used by plan. Fine-grained token with the "Copilot Requests" account permission.
# Classic tokens are not accepted. Optional if the signed-in `gh` user has a Copilot subscription.
COPILOT_GITHUB_TOKEN=
